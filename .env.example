# ── 인증 ────────────────────────────────────────────────
# 정산 메뉴 진입 비밀번호 (요구사항: 정해진 비밀번호 입력 시에만 메뉴 노출)
SETTLEMENT_PASSWORD=change-me
# 세션 쿠키 서명용 시크릿 (아무 긴 랜덤 문자열)
SESSION_SECRET=please-generate-a-long-random-secret

# ── Postgres (Railway) ─────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/settlement

# ── Google 서비스계정 (BigQuery + Sheets/Drive 공용) ────
# 서비스계정 JSON 전체를 한 줄 문자열로 넣는다. (Railway 변수에 그대로 붙여넣기)
# 이 서비스계정 이메일을 계약목록/쏠북Summary/출판사폴더에 공유해야 함.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── BigQuery (사용량 원천) ──────────────────────────────
# 서비스계정 JSON과 함께 프로젝트 ID만 있으면 기본 집계 쿼리가 동작한다.
# (기본 쿼리는 src/lib/bigquery.ts의 DEFAULT_BASE_SQL = bookips 원시 로그 쿼리 기반)
BIGQUERY_PROJECT_ID=mathpresso-data
# (선택) 원시 로그 쿼리를 통째로 교체하고 싶을 때만 사용.
#   - @START_YYYYMMDD / @END_YYYYMMDD (DATE) 파라미터 사용
#   - 노출 컬럼 필수: publisher, isbn, bookTitle, userHash
# BIGQUERY_USAGE_SQL=

# ── bookips 시트 (피벗 대조 검증용) ─────────────────────
BOOKIPS_SHEET_ID=1xtT0DcS8A3lGCSZPcpvggo4pzZhmF2w1QWeIEo_BNVU
BOOKIPS_PIVOT_TAB=Pivot

# ── Google Sheets/Drive 리소스 ID ──────────────────────
CONTRACT_SHEET_ID=1xrC3seWM8FH-MnpvE06shsbKKZOcAoIprIpboOiKQos
CONTRACT_SHEET_TAB=2026
SUMMARY_SHEET_ID=1u18mFtPXz84Yx0vgyu4w0RvxVf2lL0CF_Cz0PCYHdcw
SUMMARY_SHEET_TAB=쏠북 Summary
PUBLISHER_FOLDER_ID=1apAeN4WDIQlXmfkEtQx5nzfBj5hH_5gr

# 실데이터 연동 전 목업으로 동작시키려면 true
USE_MOCK_DATA=true
