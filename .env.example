# ── 인증 ────────────────────────────────────────────────
# 정산 메뉴 진입 비밀번호 (요구사항: 정해진 비밀번호 입력 시에만 메뉴 노출)
SETTLEMENT_PASSWORD=change-me
# 세션 쿠키 서명용 시크릿 (아무 긴 랜덤 문자열)
SESSION_SECRET=please-generate-a-long-random-secret

# ── Postgres (Railway) ─────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/settlement

# ── Google 자격증명 (둘 중 하나) ───────────────────────
# [방법 A] 본인 계정 OAuth (서비스계정 발급이 어려울 때 권장)
#   gcloud auth application-default login --scopes=https://www.googleapis.com/auth/cloud-platform
#   → ~/.config/gcloud/application_default_credentials.json 내용(authorized_user)을 그대로 넣기.
#   BigQuery만 쓰면 위 스코프로 충분. (Sheets 기능까지 쓰려면 로그인 스코프에
#   .../auth/spreadsheets, .../auth/drive 추가)
GOOGLE_OAUTH_CREDENTIALS=
#   로컬에서 gcloud로 로그인했다면 위 대신 파일 경로만 줘도 됨:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/application_default_credentials.json
#
# [방법 B] 서비스계정 JSON 한 줄 문자열 (가능한 경우)
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── BigQuery (사용량 원천) ──────────────────────────────
# 서비스계정 JSON과 함께 프로젝트 ID만 있으면 기본 집계 쿼리가 동작한다.
# (기본 쿼리는 src/lib/bigquery.ts의 DEFAULT_BASE_SQL = bookips 원시 로그 쿼리 기반)
BIGQUERY_PROJECT_ID=mathpresso-data
# (선택) 원시 로그 쿼리를 통째로 교체하고 싶을 때만 사용.
#   - @START_YYYYMMDD / @END_YYYYMMDD (DATE) 파라미터 사용
#   - 노출 컬럼 필수: publisher, isbn, bookTitle, userHash, status, consumerPrice
# BIGQUERY_USAGE_SQL=

# book_contracts.status 중 '승인(정산대상)'으로 볼 값 (쉼표 구분). ALLOWED만 승인.
CONTRACT_ACTIVE_STATUSES=ALLOWED

# ── bookips 시트 (피벗 대조 검증용) ─────────────────────
BOOKIPS_SHEET_ID=1xtT0DcS8A3lGCSZPcpvggo4pzZhmF2w1QWeIEo_BNVU
BOOKIPS_PIVOT_TAB=Pivot

# ── Google Sheets/Drive 리소스 ID ──────────────────────
# IP LIST(계약 목록) 시트 = 정산 기준. 시트 읽기에 spreadsheets 스코프 필요.
CONTRACT_SHEET_ID=1xrC3seWM8FH-MnpvE06shsbKKZOcAoIprIpboOiKQos
# 정산 기준 탭: gid 또는 탭명 중 하나 (탭명이 있으면 우선)
CONTRACT_SHEET_GID=682428382
# CONTRACT_SHEET_TAB=2026
SUMMARY_SHEET_ID=1u18mFtPXz84Yx0vgyu4w0RvxVf2lL0CF_Cz0PCYHdcw
SUMMARY_SHEET_TAB=쏠북 Summary
PUBLISHER_FOLDER_ID=1apAeN4WDIQlXmfkEtQx5nzfBj5hH_5gr

# 실데이터 연동 전 목업으로 동작시키려면 true
USE_MOCK_DATA=true
